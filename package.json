{
  "name": "email-bitrix-app",
  "version": "1.0.0",
  "description": "Multi-tenant application that receives emails via IMAP and automatically creates deals in Bitrix24",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:props": "vitest run src/__tests__/properties/",
    "migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "5.1.1",
    "bullmq": "5.34.8",
    "dotenv": "16.4.7",
    "fastify": "5.3.3",
    "imapflow": "1.0.172",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "mailparser": "3.7.2",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "fast-check": "4.1.1",
    "vitest": "3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "email",
    "bitrix24",
    "imap",
    "crm",
    "multi-tenant"
  ],
  "license": "UNLICENSED",
  "private": true
}
