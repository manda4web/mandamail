# ============================================
# Email-Bitrix App - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database ---
# PostgreSQL connection string (docker-compose default: user/pass/db "emailbitrix")
DATABASE_URL=postgresql://emailbitrix:emailbitrix@localhost:5432/emailbitrix

# --- Redis ---
# Redis connection string (startup health-check only; retry jobs use PostgreSQL)
REDIS_URL=redis://localhost:6379

# --- Security ---
# AES-256-GCM encryption key for IMAP passwords at rest (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=cole_aqui_64_caracteres_hex

# --- Server ---
# HTTP server port
PORT=3000

# Node environment (production, development, test)
NODE_ENV=production

# --- Authentication ---
# Secret used to sign JWT tokens
JWT_SECRET=outro_segredo_longo_aqui

# JWT token expiration (e.g., 7d, 24h, 15m)
JWT_EXPIRES_IN=7d

# --- Bitrix24 OAuth ---
# Client ID and Secret from Bitrix24 Marketplace app
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Application token (from Bitrix24 app settings — validates auth requests)
BITRIX_APP_TOKEN=

# Email treated as super-admin in /auth/bitrix (auto-grants access to any portal)
SUPER_ADMIN_EMAIL=comercial@manda4.com.br

# --- Stripe (billing: plans/coupons/subscriptions) ---
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=

# --- Alert Service ---
# Interval in seconds between SLA checks for stuck emails
ALERT_CHECK_INTERVAL_SEC=60

# Minutes without an IMAP poll before an account is flagged "silent" and alerted
# (independent of email volume — catches a dead account with no traffic).
SILENT_ACCOUNT_MINUTES=15

# --- External Heartbeat (dead-man's-switch) ---
# Optional. URL of an external monitor (Healthchecks.io, cron.org, UptimeRobot
# push, BetterStack, etc.) that the app pings on a fixed cadence. If the process
# or server dies, the pings stop and the external monitor raises the alarm —
# covering the outage the in-process AlertService cannot report. Leave empty to
# disable. Example: https://hc-ping.com/your-uuid
HEARTBEAT_URL=
# Seconds between heartbeat pings (should be well under the monitor's grace period)
HEARTBEAT_INTERVAL_SEC=60

# --- Logging ---
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# --- SMTP (for email alerts) ---
# SMTP server host
SMTP_HOST=smtp.empresa.com

# SMTP server port
SMTP_PORT=587

# SMTP authentication user
SMTP_USER=alertas@empresa.com

# SMTP authentication password
SMTP_PASS=senha_smtp

# Email address used as the "From" field in alert emails
SMTP_FROM=alertas@empresa.com
